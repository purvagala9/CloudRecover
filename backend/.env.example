# Copy this file to backend/.env and supply a persistent key.
# Generate a Fernet key once; keep the same value across restarts/backups.
CLOUDRECOVER_ENCRYPTION_KEY=

# Authentication is enabled by default. Generate a persistent secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDRECOVER_SESSION_SECRET=
CLOUDRECOVER_ADMIN_PASSWORD=ca$123
# Set true when serving over HTTPS.
CLOUDRECOVER_COOKIE_SECURE=false

# AWS settings may also be supplied through the AWS CLI profile.
S3_BUCKET=cloudrecover-backups
AWS_REGION=ap-southeast-2
S3_PREFIX=cloudrecover/backups
